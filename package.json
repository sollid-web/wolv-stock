{
  "name": "wolv-stock-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build  --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:hardening": "node scripts/hardening-smoke.mjs",
    "test:logic": "bash -lc 'node --conditions=react-server --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test $(printf \"%s\\n\" scripts/*.test.mjs | grep -v postgres-integration.test.mjs)'",
    "test:postgres": "node --conditions=react-server --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/postgres-integration.test.mjs",
    "test:provider": "node --disable-warning=ExperimentalWarning scripts/real-binance-provider.test.mjs",
    "test:responsive": "node scripts/responsive-smoke.mjs"
  },
  "dependencies": {
    "@bnbagent/sdk": "^0.6.1",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@tanstack/react-query": "^5.62.0",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/extensions": "^2.27.0",
    "@x402/svm": "^2.27.0",
    "@zerodev/permissions": "^5.6.4",
    "@zerodev/sdk": "^5.5.11",
    "lightweight-charts": "^5.2.1",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

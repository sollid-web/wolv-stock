# Binance Web3 API (server-side only)
BINANCE_API_KEY=your_web3_api_key
BINANCE_SECRET_KEY=your_web3_api_secret

# Server-only BSC RPC endpoint for authenticated/private RPC providers.
# Keep credentials here; never use NEXT_PUBLIC_ for authenticated endpoints.
BSC_RPC_URL=

# Optional second read-only endpoint for the metadata audit. Cross-RPC checks
# require distinct operator labels configured below; labels are operator-asserted.
BSC_RPC_OPERATOR=
BSC_RPC_SECONDARY_URL=
BSC_RPC_SECONDARY_OPERATOR=

# Optional server-only archive-capable endpoint for confirmed historical-state probes.
# Archive capability is established by successful reads at the recorded block, not by this label.
BSC_RPC_ARCHIVE_URL=
BSC_RPC_ARCHIVE_OPERATOR=
BSC_RPC_ARCHIVE_INDEPENDENCE_CONFIRMED=

# Public BSC JSON-RPC endpoint for browser wallet transports (no path token,
# URL credentials, query parameters, or fragment; defaults to a public endpoint).
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Optional WalletConnect configuration
NEXT_PUBLIC_WALLET_PROJECT_ID=your_walletconnect_project_id

# Optional server-side WOLV AI explanation layer
WOLV_AI_API_KEY=your_openai_compatible_key
WOLV_AI_BASE_URL=https://api.openai.com/v1
WOLV_AI_MODEL=gpt-5-mini

# Do not put an owner or session private key in environment variables.
# Agent session keys are generated in browser memory and are not persisted.

# Foundry hook deployment only; never use this key in the web application.
DEPLOYER_PRIVATE_KEY=
BSC_CHAIN_ID=56

# Defaults by BSC_CHAIN_ID: canonical V2 router on mainnet and verified testnet V2 router.
PANCAKESWAP_V2_ROUTER=

# EntryPoint v0.7 is deployed on BSC mainnet and testnet; override only after verifying it.
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Client-side smart-account configuration. Bundler URLs are visible to users:
# use a public endpoint without embedded API credentials.
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_BSC_BUNDLER_RPC_URL=
NEXT_PUBLIC_BSC_TESTNET_BUNDLER_RPC_URL=
NEXT_PUBLIC_ROUTER_ADDRESS=0x9Ac64Cc6e4415144C455BD8E4837Fea55603e5c3
NEXT_PUBLIC_POLICY_HOOK_ADDRESS=
NEXT_PUBLIC_AGENT_TARGET_TOKEN_ADDRESS=

# Server-only kill switch for services/agentExecutor.ts.
# Keep false for local development and tests. The executor currently refuses chain ID 56.
ENABLE_LIVE_USEROP_SUBMISSION=false

# Server-only path to the Binance Agentic Wallet CLI binary used by
# services/bawCli.ts. Never expose this setting to browser code.
BAW_BIN=baw

# Server-only bearer secret protecting trusted BAW API callers and signing
# short-lived browser-wallet sessions. Never expose this to browser code.
BAW_WALLET_API_TOKEN=
# Comma-separated allowlist of browser wallet addresses authorized to control
# the separate BAW operator wallet. Browser-wallet ownership is not operator
# wallet ownership; an empty or invalid list disables browser authentication.
BAW_AUTHORIZED_BROWSER_WALLETS=
# TLS PostgreSQL connection string for the managed execution/authentication
# ledger. Use a server-only managed database credential, never NEXT_PUBLIC_.
BAW_EXECUTION_DATABASE_URL=

# WOLV Phase 4.0 agent memory. The store falls back to WOLV_TRADING_DATABASE_URL
# when this dedicated server-only PostgreSQL URL is empty.
WOLV_AGENT_DATABASE_URL=
# Both capabilities remain disabled unless an operator explicitly enables them.
WOLV_AGENT_CONTROL_PLANE_ENABLED=false
WOLV_MARKET_COLLECTOR_ENABLED=false

# BAW execution remains disabled unless all required configuration is set.
BAW_EXECUTION_ENABLED=false
BAW_EXECUTION_KILL_SWITCH=true
# Required hard caps; set only after defining the operator's reviewed limits.
BAW_EXECUTION_MAX_ORDER_USDT=
BAW_EXECUTION_DAILY_LIMIT_USDT=
# Hard-capped at 100 bps (1%) in the execution service.
BAW_EXECUTION_MAX_SLIPPAGE_BPS=
# Conservative BNB reserve required in addition to the requested trade balance.
BAW_EXECUTION_MIN_BNB_RESERVE=

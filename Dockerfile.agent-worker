FROM node:22-bookworm-slim

WORKDIR /app

RUN corepack enable \
    && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod=false

COPY --chown=node:node . .

ENV NODE_ENV=production
USER node

CMD ["node", "--conditions=react-server", "--disable-warning=ExperimentalWarning", "--disable-warning=MODULE_TYPELESS_PACKAGE_JSON", "--experimental-strip-types", "worker/agentWorker.ts"]
